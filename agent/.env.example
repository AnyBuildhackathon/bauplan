# Copy this file to agent/.env and fill in what you use; every value is optional.
# agent/.env is gitignored: never commit it or paste a key anywhere else.
# Variables already set in the shell win over this file. See README.md, Configuration.

# Claude: an API key, or leave empty to use the local Claude Code subscription when logged in.
ANTHROPIC_API_KEY=

# SparkBench checkout for circuit_design, when it is not in ~/.cache/anybuild/sparkbench/<commit>
# (bash agent/scripts/setup_sparkbench.sh installs it there).
SPARKBENCH_DIR=

# Parts exploration: 1 lets a part found on the web carry clearly labelled estimates for its
# non-critical numbers so a test build goes on; 0 (default) keeps every part number sourced.
PAI_ALLOW_ESTIMATED=

# Distributor APIs: exact electronics specs, datasheets, prices and stock, searched before the
# generic web search. Each one is used only when its values are set.

# Digi-Key Product Information API v4 (https://developer.digikey.com):
# sign in, Organizations > create one, open it > Production Apps > Create Production App,
# tick the "Product Information V4" product (any OAuth callback, e.g. https://localhost),
# then open the app and copy its Client ID and Client Secret here.
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=

# Nexar / Octopart (https://portal.nexar.com): sign up, create an app, give it the Supply scope,
# and copy its Client ID and Client Secret from the app's Authorization tab here.
# The secret is shown only once: copy it when it appears.
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=

# Mouser Search API (https://www.mouser.com/api-search/): log in to My Mouser, sign up for the
# Search API, and copy the key from the APIs page of your account (it is also emailed) here.
# Mouser allows 30 calls a minute and 1,000 a day; AnyBuild stays inside both.
MOUSER_API_KEY=
