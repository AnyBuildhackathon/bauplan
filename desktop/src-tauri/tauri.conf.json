{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bauplan",
  "version": "0.1.0",
  "identifier": "dev.bauplan.desktop",
  "build": {
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../../web", "wait": false },
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": { "script": "npm run build:desktop", "cwd": "../../web" },
    "frontendDist": "../../web/dist-desktop"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"]
  }
}
