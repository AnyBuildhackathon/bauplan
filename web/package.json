{
  "name": "physical-ai-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:desktop": "tsc -b && vite build --mode desktop --outDir dist-desktop",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:live": "E2E_LIVE=1 playwright test -c e2e/playwright.config.ts e2e/live.spec.ts"
  },
  "dependencies": {
    "@mujoco/mujoco": "^3.17.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.186.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.5"
  }
}
